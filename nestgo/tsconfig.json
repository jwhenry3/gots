{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "./plugin"
      }
    ]
  },
  "include": [
    "types/**/*.d.ts",
    "src/**/*.ts",
    "nest/**/*.ts"
  ]
}